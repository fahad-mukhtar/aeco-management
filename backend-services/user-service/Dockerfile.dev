ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=100

WORKDIR /app

# Copy dependency manifests first so pip layers stay cached unless requirements change
COPY requirements /tmp/backend/requirements
COPY user-service/requirements.txt /tmp/backend/user-service/requirements.txt

RUN pip install --upgrade pip \
    && pip install -r /tmp/backend/user-service/requirements.txt

# Copy the FastAPI source code and Alembic assets last
COPY user-service/app /app/app
COPY user-service/alembic.ini /app/alembic.ini
COPY user-service/alembic /app/alembic

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
